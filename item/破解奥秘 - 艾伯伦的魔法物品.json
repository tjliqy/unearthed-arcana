			"ENG_name": "Band of Loyalty",
			"name": "忠诚戒指",
			"source": "UAMagicItemsofEberron",
			"page": 2,
			"reprintedAs": [
				"忠诚戒指|UAWayfindersGuideToEberron"
			],
			"type": "RG|DMG",
			"rarity": "common",
			"reqAttune": true,
			"entries": [
				"如果你在佩戴这枚戒指时生命值降至0，你会立即死亡。这些戒指深受那些不能落入仇敌之手的间谍们青睐。"
			]
