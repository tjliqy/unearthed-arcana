									"source": "UAMagicItemsofEberron",
									"page": 2
								},
								{
									"ENG_name": "Shiftweave",
									"name": "百变外套",
									"type": "statblock",
									"tag": "item",
									"source": "UAMagicItemsofEberron",
									"page": 2
								},
								{
									"ENG_name": "Spellshard",
									"name": "法术晶格",
									"type": "statblock",
									"tag": "item",
									"source": "UAMagicItemsofEberron",
									"page": 3
