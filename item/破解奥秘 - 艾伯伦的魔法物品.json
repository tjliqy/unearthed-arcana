	"variantrule": [
		{
			"ENG_name": "Two-Handed Arcane Focuses",
			"name": "双手奥术法器",
			"source": "UAMagicItemsofEberron",
			"page": 2,
			"reprintedAs": [
				"双手奥术法器|UAWayfindersGuideToEberron"
			],
			"ruleType": "O",
			"entries": [
				"在艾伯伦，奥术法器是一种武器。因此，可以有趣地赋予法器一些与寻常武器相同的权衡：你是否会为了更强的法力而牺牲自由手？",
				"如果你使用此可选规则，当施法者使用双手奥术法器施放攻击性戏法（需要豁免检定或攻击检定的戏法）时，该戏法的范围增加50%。",
				"根据这条规则，法杖总是需要双手持握，而权杖可以用单手或双手使用。使用双手奥术法器可以满足法术的姿势成分要求。"
			]
		}
	],
