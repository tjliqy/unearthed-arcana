	"subclassFeature": [
		{
			"ENG_name": "Warrior of the Mystic Arts",
			"name": "秘术武者",
			"source": "XUA2026MysticSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "XPHB",
			"subclassShortName": "秘术",
			"subclassSource": "XUA2026MysticSubclasses",
			"level": 3,
			"header": 1,
			"entries": [
				"秘术武者运用魔法来增强他们的战斗技能。他们驾驭自身的超自然专注来提升其魔法与身体能力。",
				{
					"type": "refSubclassFeature",
					"subclassFeature": "施法|武僧|XPHB|秘术|XUA2026MysticSubclasses|3|XUA2026MysticSubclasses"
				}
			]
		},
		{
			"ENG_name": "Spellcasting",
			"name": "施法",
			"source": "XUA2026MysticSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "XPHB",
			"subclassShortName": "秘术",
			"subclassSource": "XUA2026MysticSubclasses",
			"level": 3,
			"header": 2,
			"entries": [
				"你已学会施法。关于施法的规则，请参阅{@book 玩家手册|XPHB|7}。下方的信息详述了你作为秘术战士如何使用这些规则。",
				{
					"ENG_name": "Cantrips",
					"name": "戏法",
					"type": "entries",
					"entries": [
						"你从术士法术列表中选择两道戏法。推荐选择{@spell 剑刃防护}和{@spell 鸣雷破|XPHB}。每当你提升一个武僧等级时，你可以将其中一道戏法替换为术士法术列表中的另一道戏法。",
						"当你达到武僧第10层时，你可以选择学习另一个术士戏法。"
					]
				},
				{
					"ENG_name": "Spell Slots",
					"name": "法术位",
