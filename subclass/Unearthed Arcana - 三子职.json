	"subclassFeature": [
		{
			"ENG_name": "Circle of Spores (UA)",
			"name": "孢子结社（UA）",
			"source": "UAThreeSubclasses",
			"page": 1,
			"className": "德鲁伊",
			"classSource": "PHB",
			"subclassShortName": "孢子（UA）",
			"subclassSource": "UAThreeSubclasses",
			"level": 2,
			"entries": [
				"孢子结社的德鲁伊们在衰竭中发现美丽。他们在霉菌和其他真菌中看到将无生命的材质转化为丰富（尽管有些奇怪）生命的能力。这些德鲁伊相信生死是宏大循环的一部分，彼此相生相续。死亡并非生命的终结，而是一种状态的转变，使生命进入新形态。这个结社的德鲁伊与亡灵有着复杂的关系。与大多数其他德鲁伊不同，他们认为不死本身并无过错，视其为生死循环的同伴。然而，这些德鲁伊相信当循环的每个环节都充满活力且不断变化时，自然循环才是最健康的。那些试图用不死取代所有生命，或逃避最终安息的亡灵，违背了循环，必须被阻止。",
				{
					"type": "refSubclassFeature",
					"subclassFeature": "结社法术|德鲁伊||孢子（UA）|UAThreeSubclasses|2"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "孢子环绕|德鲁伊||孢子（UA）|UAThreeSubclasses|2"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "一体共生|德鲁伊||孢子（UA）|UAThreeSubclasses|2"
				}
			]
		},
		{
			"ENG_name": "Circle Spells",
			"name": "结社法术",
			"source": "UAThreeSubclasses",
			"page": 1,
			"className": "德鲁伊",
			"classSource": "PHB",
			"subclassShortName": "孢子（UA）",
			"subclassSource": "UAThreeSubclasses",
			"level": 2,
			"header": 1,
			"entries": [
				"你与真菌的共生联系以及你利用生死循环的能力赋予了你某些法术。在1级时，你学会{@spell 颤栗之触}戏法。在3级、5级、7级和9级时，你可以获得孢子结社法术表格中对应等级的法术。",
				"一旦你习得这些法术中任意一个，你就会一直准备着它，且不计入你的每日准备法术上限。如果你学会一个不在德鲁伊法术列表中的法术，该法术对你来说视作德鲁伊法术。",
				{
					"type": "table",
					"caption": "孢子结社法术",
					"colLabels": [
						"德鲁伊等级",
						"结社法术"
					],
					"colStyles": [
						"col-2 text-center",
						"col-10"
					],
					"rows": [
						[
							"3rd",
							"{@spell 遗体防腐}, {@spell 衰弱射线}"
						],
						[
							"5th",
							"{@spell 活化死尸}, {@spell 气化形体}"
						],
						[
							"7th",
							"{@spell 枯萎术}, {@spell 困惑术}"
						],
						[
							"9th",
							"{@spell 死云术}, {@spell 疫病术}"
						]
					]
				}
			]
		},
