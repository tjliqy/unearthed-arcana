			"ENG_name": "Halo of Spores",
			"name": "孢子环绕",
			"source": "UAThreeSubclasses",
			"page": 1,
			"className": "德鲁伊",
			"classSource": "PHB",
			"subclassShortName": "孢子（UA）",
