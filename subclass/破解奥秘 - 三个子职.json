	"subclassFeature": [
		{
			"ENG_name": "Way of the Drunken Master",
			"name": "醉拳宗",
			"source": "UAATrioOfSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "PHB",
			"subclassShortName": "醉拳（UA）",
			"subclassSource": "UAATrioOfSubclasses",
			"level": 3,
			"entries": [
				"醉拳宗教导其学生以醉汉般抽搐、不可预测的动作移动。醉拳大师摇摇晃晃，步履不稳，看似无能战斗员却令人难以对付。醉拳大师不规则的蹒跚隐藏着精心执行的格挡、招架、前进、攻击和撤退的舞蹈。狡黠的武者能看穿醉拳大师表面的无能，认识到其所运用的高超技巧。",
				{
					"type": "refSubclassFeature",
					"subclassFeature": "醉拳技巧|武僧||醉拳（UA）|UAATrioOfSubclasses|3"
				}
			]
		},
		{
			"ENG_name": "Drunken Technique",
			"name": "醉拳技巧",
			"source": "UAATrioOfSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "PHB",
			"subclassShortName": "醉拳（UA）",
			"subclassSource": "UAATrioOfSubclasses",
			"level": 3,
			"header": 1,
			"entries": [
				"当你在3级选择此传统时，若尚未拥有则获得{@skill 表演}技能的熟练；你的武艺技巧将战争训练与舞者的精准和小丑的表演动作相结合。",
				"你还学会了如何作为疾风连击的一部分快速转折和转向。每当你使用疾风连击时，你将获得{@action 撤离}动作的增益，且你的步行速度增加10尺直到当前回合结束。"
			]
		},
		{
			"ENG_name": "Tipsy Sway",
			"name": "酣醉若狂",
			"source": "UAATrioOfSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "PHB",
			"subclassShortName": "醉拳（UA）",
			"subclassSource": "UAATrioOfSubclasses",
			"level": 6,
			"header": 2,
			"entries": [
				"在6级时，你在战斗中的摇摆变得疯狂地不可预测。当一个敌人用近战攻击掷骰未命中你时，你可以用一个反应使该攻击命中你能看见的5尺内的一个你选择的生物（攻击手除外）。一旦你使用了这个特性，直到你完成一次短休或长休前都不能再次使用它。"
			]
		},
		{
			"ENG_name": "Drunkard's Luck",
			"name": "醉汉机运",
			"source": "UAATrioOfSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "PHB",
			"subclassShortName": "醉拳（UA）",
			"subclassSource": "UAATrioOfSubclasses",
			"level": 11,
			"header": 2,
			"consumes": {
				"ENG_name": "Ki",
				"name": "Ki"
			},
			"entries": [
				"从11级开始，你似乎总能在关键时刻获得幸运的反弹，使你免于末日。当你进行豁免检定时，你可以消耗1点气来使自己在该掷骰上获得优势。你必须在掷骰前决定使用此特性。"
			]
		},
		{
			"ENG_name": "Intoxicated Frenzy",
			"name": "酣醉若狂",
			"source": "UAATrioOfSubclasses",
			"page": 1,
			"className": "武僧",
			"classSource": "PHB",
			"subclassShortName": "醉拳（UA）",
			"subclassSource": "UAATrioOfSubclasses",
			"level": 17,
			"header": 2,
			"entries": [
				"在17级时，你获得对一群敌人发动压倒性数量攻击的能力。当你使用疾风连击时，可以额外进行最多三次攻击（总计五次攻击），前提是本回合中每次疾风连击攻击的目标都是不同的生物。"
			]
		},
		{
			"ENG_name": "Oath of Redemption",
			"name": "救赎之誓",
			"source": "UAATrioOfSubclasses",
			"page": 1,
			"className": "圣武士",
			"classSource": "PHB",
			"subclassShortName": "救赎（UA）",
			"subclassSource": "UAATrioOfSubclasses",
			"level": 3,
			"entries": [
				"救赎之誓将圣武士置于一条艰难的路途，这条道路要求神圣武者仅将暴力作为绝境反扑。致力于此信条的圣武士相信任何人都可被救赎，且仁慈与正义之路人人皆可行走。这些圣武士面对邪恶生物时心怀将其引向光照的希望，唯有当此举能明确拯救其他生命时才会剿灭它们。追随此道的圣武士被称为救赎者。",
				"尽管救赎者是理想主义者，但他们并非愚人。救赎者知道亡灵、恶魔、魔鬼及其他超自然威胁可能是与生俱来的邪恶。面对这些敌人时，圣武士们会倾泻其武器与法术的全部怒火。然而救赎者仍祈祷着，终有一日，甚至不义的生物也会主动寻求救赎。",
				{
					"type": "refSubclassFeature",
					"subclassFeature": "救赎之信条|圣武士||救赎（UA）|UAATrioOfSubclasses|3"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "圣誓法术|圣武士||救赎（UA）|UAATrioOfSubclasses|3"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "和平护甲|圣武士||救赎（UA）|UAATrioOfSubclasses|3"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "和解武者|圣武士||救赎（UA）|UAATrioOfSubclasses|3"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "引导神力|圣武士||救赎（UA）|UAATrioOfSubclasses|3"
				}
			]
		},
