		{
			"ENG_name": "Oath of Conquest",
			"name": "征服之誓",
			"source": "UAPaladin",
			"page": 1,
			"className": "{!@ {!@ #UA}}",
			"classSource": "PHB",
			"subclassShortName": "征服（UA）",
			"subclassSource": "UAPaladin",
			"level": 3,
			"entries": [
				"征服之誓召唤那些在战斗中寻求荣耀并渴望征服敌人的圣武士。对这些圣武士而言，仅仅建立秩序是不够的。他们必须镇压混乱的力量。这些被称为暴政骑士或铁腕者的誓约者们，会组成服务于战争之神或严苛力量哲学的噩兆骑士团。其中部分圣武士甚至与九层地狱的势力勾结\u2014\u2014阿弗纳斯的督军、大魔鬼贝尔就将许多被称为地狱骑士的征服誓约者视为最狂热的支持者。地狱骑士们用堕落敌人的战利品装饰护甲，作为对胆敢违抗他们及其领主法令者的严厉警告。",
				{
					"type": "refSubclassFeature",
					"subclassFeature": "征服之信条|{!@ {!@ #UA}}||征服（UA）|UAPaladin|3"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "圣誓法术|{!@ {!@ #UA}}||征服（UA）|UAPaladin|3"
				},
				{
					"type": "refSubclassFeature",
					"subclassFeature": "引导神力|{!@ {!@ #UA}}||征服（UA）|UAPaladin|3"
				}
			]
		},
