		{
			"ENG_name": "Conquering Strike",
			"name": "征服打击",
			"source": "UAPaladin",
			"page": 1,
			"className": "{!@ {!@ #UA}}",
			"classSource": "PHB",
			"subclassShortName": "征服（UA）",
			"subclassSource": "UAPaladin",
			"level": 3,
			"header": 1,
			"entries": [
				"你可以使用你的引导神力来粉碎敌人的意志。当你以近战武器攻击命中一个生物作为{@action 攻击}动作的一部分时，你也可以使用你的引导神力迫使目标进行一次感知豁免检定。豁免失败时，目标会对你陷入{@condition 恐慌}状态1分钟。该{@condition 恐慌}的生物可以在其每回合结束时重复此豁免检定，成功时终止对其自身的效应。"
			]
		},
		{
			"ENG_name": "Guided Strike",
			"name": "导引打击",
			"source": "UAPaladin",
			"page": 1,
			"className": "{!@ {!@ #UA}}",
			"classSource": "PHB",
			"subclassShortName": "征服（UA）",
			"subclassSource": "UAPaladin",
			"level": 3,
			"header": 1,
			"entries": [
				"你在进行攻击检定时，可以使用引导神力令该次检定获得+10加值。你可以在看到掷骰结果后DM公布是否命中前，决定是否使用该特性。"
			]
		},
