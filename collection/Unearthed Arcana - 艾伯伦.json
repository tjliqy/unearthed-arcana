							"3rd",
							"+1武器或+1护盾"
						],
						[
							"4th",
							"+1 护甲"
						],
						[
							"5th",
							"+2武器或+2弹药（20件）"
						],
						[
							"6th",
							"+2 护甲"
						]
					]
				}
			]
		},
